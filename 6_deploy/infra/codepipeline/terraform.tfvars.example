# Copy to terraform.tfvars and edit for your account/repo.

aws_region  = "eu-central-1"
environment = "production"

# The CodeCommit repository name and the pipeline source.
repository_name = "spbc-tech-assistant"

# Default web-app sign-in user (created by deploy.sh's user step). The password is generated
# and stored in Secrets Manager as spbc-demo-user; read it with `make demo-user`.
# demo_username = "demo"

# Optional frontend smoke test. Only runs when toggle_smoke is true AND this is set.
# smoke_test_url = "https://app.example.com"

# Optional email subscribed to the manual-approval SNS topic.
# approval_email = "ops@example.com"

# execution_role_name_patterns rarely needs overriding; the default covers every role the
# deploy path creates/updates/passes (SPBC-*, Cognito_*, the Bedrock KB execution role, and
# the AgentCore starter-toolkit role).
